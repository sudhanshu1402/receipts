{
  "name": "@sudhanshu1402/receipts",
  "version": "0.2.0",
  "description": "Checks what an AI coding agent said it did against what it actually did, and prints the difference. Reads the Claude Code session transcript, costs no context tokens.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "receipts": "bin/receipts.js"
  },
  "files": [
    "bin",
    "src",
    "commands",
    ".claude-plugin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "receipts": "node bin/receipts.js",
    "assets": "node scripts/make-readme-svg.mjs"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "hooks",
    "agent-verification",
    "transcript",
    "observability",
    "zero-token"
  ],
  "author": "Sudhanshu Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudhanshu1402/receipts.git"
  },
  "homepage": "https://github.com/sudhanshu1402/receipts#readme",
  "bugs": {
    "url": "https://github.com/sudhanshu1402/receipts/issues"
  }
}
